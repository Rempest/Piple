<?xml version="1.0"?>
<robot name="piple">

  <!-- ======================================================= -->
  <!-- Base Footprint                                          -->
  <!-- ======================================================= -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.080" rpy="0 0 0"/>
  </joint>

  <!-- ======================================================= -->
  <!-- Base Link                                                -->
  <!-- ======================================================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0.02 -0.02 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://piple/meshes/piple_base_link.obj" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.25 0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.020" ixy="0" ixz="0" iyy="0.040" iyz="0" izz="0.050"/>
    </inertial>

  </link>

  <!-- ======================================================= -->
  <!-- Front Left Wheel                                        -->
  <!-- ======================================================= -->

  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
       <mesh filename="package://piple/meshes/front_left_wheel_link.obj" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.0795" length="0.045"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.00043" ixy="0" ixz="0" iyy="0.00079" iyz="0" izz="0.00043"/>
    </inertial>
  </link>

  <!-- ======================================================= -->
  <!-- Front Right Wheel                                       -->
  <!-- ======================================================= -->

  <link name="front_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://piple/meshes/front_right_wheel_link.obj" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.0795" length="0.045"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.00043" ixy="0" ixz="0" iyy="0.00079" iyz="0" izz="0.00043"/>
    </inertial>
  </link>

  <!-- ======================================================= -->
  <!-- Rear Left Wheel                                         -->
  <!-- ======================================================= -->

  <link name="rear_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://piple/meshes/rear_left_wheel_link.obj" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.0795" length="0.045"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.00043" ixy="0" ixz="0" iyy="0.00079" iyz="0" izz="0.00043"/>
    </inertial>
  </link>

  <!-- ======================================================= -->
  <!-- Rear Right Wheel                                        -->
  <!-- ======================================================= -->

  <link name="rear_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://piple/meshes/rear_right_wheel_link.obj" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.0795" length="0.045"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.00043" ixy="0" ixz="0" iyy="0.00079" iyz="0" izz="0.00043"/>
    </inertial>
  </link>

  <!-- ======================================================= -->
  <!-- Wheel Joints                                            -->
  <!-- ======================================================= -->
   <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.3 -0.04 -0.16700" rpy="0 0 0"/>
  </joint>

  <joint name="front_left_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="front_left_wheel_link"/>
      <origin xyz="0.30 0.19 -0.08" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="60" velocity="30"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="front_right_wheel_link"/>
      <origin xyz="0.30 -0.19 -0.08" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="60" velocity="30"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="rear_left_wheel_link"/>
      <origin xyz="-0.05 0.19 -0.08" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="60" velocity="30"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="rear_right_wheel_link"/>
      <origin xyz="-0.05 -0.19 -0.08" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="60" velocity="30"/>
  </joint>



<!-- ======================================================= -->
<!-- Camera Link                                              -->
<!-- ======================================================= -->

  <link name="camera_link">

    <visual>
      <geometry>
        <mesh filename="package://piple/meshes/camera.obj" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>

        <origin xyz="0 0 0"/>

      <inertia
        ixx="0.00001"
        iyy="0.00001"
        izz="0.00001"
        ixy="0"
        ixz="0"
        iyz="0"/>
      </inertial>

    </link>
  
  <!-- ======================================================= -->
  <!-- LIDAR                                                    -->
  <!-- ======================================================= -->

  <link name="lidar_link">

    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.02"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.025" length="0.02"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.05"/>

      <inertia
        ixx="0.00001"
        iyy="0.00001"
        izz="0.00001"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>

  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.09 -0.02 0.0003" rpy="0 0 0"/>
  </joint>


  <!-- ======================================================= -->
  <!-- ROS2 Control                                             -->
  <!-- ======================================================= -->

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ======================================================= -->
  <!-- Gazebo Plugin                                           -->
  <!-- ======================================================= -->

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/raempest/Raempest/piple_ws/src/piple/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="camera_link">

  <sensor name="camera" type="camera">
    <update_rate>45</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
    <camera>
      <horizontal_fov>1.5707</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>100.0</far>
      </clip>
    </camera>
    <always_on>true</always_on>
    <visualize>true</visualize>
  </sensor>
</gazebo>

  <!-- ======================================================= -->
  <!-- Gazebo LiDAR                                             -->
  <!-- ======================================================= -->

  <gazebo reference="lidar_link">

    <sensor name="lidar" type="gpu_lidar">

      <update_rate>10</update_rate>

      <topic>/piple/lidar/scan</topic>

      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>

      <always_on>true</always_on>
      <visualize>true</visualize>

    </sensor>

  </gazebo>

</robot>